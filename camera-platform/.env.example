# ── Azure IoT & Storage ───────────────────────────────────────────────────────
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<hub>.azure-devices.net;DeviceId=<device>;SharedAccessKey=<key>
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=camera-recordings
AZURE_KEYVAULT_URI=https://<vault-name>.vault.azure.net/

# ── Camera connection ─────────────────────────────────────────────────────────
# RTSP URL from your camera after you verify port 554 is open.
# Supply YOUR credentials (the ones you configured on the device).
# Never leave credentials here in source control.
RTSP_URL=rtsp://<user>:<pass>@<camera-ip>:554/ch0_0.264

# ── Local recording ───────────────────────────────────────────────────────────
SNAPSHOT_DIR=./data/snapshots
RECORDING_DIR=./data/recordings
TELEMETRY_INTERVAL_SECONDS=30

# ── Gateway API ───────────────────────────────────────────────────────────────
API_KEY=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
