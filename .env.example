# ── IoT Hub connectivity (choose one) ────────────────────────────────────────
# Standalone device mode
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<hub>.azure-devices.net;DeviceId=<device>;SharedAccessKey=<key>

# IoT Edge module mode – set by the Edge runtime; do not populate manually
# IOTEDGE_WORKLOADURI=
# IOTEDGE_DEVICEID=

# ── Camera device ─────────────────────────────────────────────────────────────
# Linux USB/UVC: /dev/video0  |  Windows: 0  (OpenCV index)
CAMERA_DEVICE_PATH=/dev/video0

# WiFi camera (YI YHS.3017 and similar): set RTSP URL instead of device path.
# Example for YI Outdoor 1080p on local network (verify stream path for your model):
# CAMERA_RTSP_URL=rtsp://192.168.1.x/ch0_0.264
CAMERA_RTSP_URL=

# Optional: populated from camera label for metadata reporting
CAMERA_FCC_ID=2AFIB-YHS3017
CAMERA_MODEL=YI Outdoor Camera 1080p

# ── Stream (disabled by default – enable only on secure local network) ────────
STREAM_ENABLED=false
STREAM_PROTOCOL=rtsp
STREAM_PORT=8554
# STREAM_USERNAME=<rotate-regularly>
# STREAM_PASSWORD=<rotate-regularly>

# ── Snapshots & recordings ────────────────────────────────────────────────────
SNAPSHOT_INTERVAL_SECONDS=0
SNAPSHOT_DIRECTORY=./data/snapshots

# ── Management REST API (consumed by Windows/Android Flutter UI) ──────────────
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8080
# API_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
