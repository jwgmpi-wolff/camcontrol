{
  "$schema-template": "4.0.0",
  "modulesContent": {
    "$edgeAgent": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "runtime": {
          "type": "docker",
          "settings": {
            "minDockerVersion": "v1.25",
            "loggingOptions": "",
            "registryCredentials": {}
          }
        },
        "systemModules": {
          "edgeAgent": {
            "type": "docker",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-agent:1.5",
              "createOptions": {}
            }
          },
          "edgeHub": {
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-hub:1.5",
              "createOptions": {
                "HostConfig": {
                  "PortBindings": {
                    "5671/tcp": [{ "HostPort": "5671" }],
                    "8883/tcp": [{ "HostPort": "8883" }],
                    "443/tcp": [{ "HostPort": "443" }]
                  }
                }
              }
            },
            "env": {}
          }
        },
        "modules": {
          "camera-bridge": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "${MODULES.camera-bridge}",
              "createOptions": {
                "HostConfig": {
                  "Devices": [
                    {
                      "PathOnHost": "/dev/video0",
                      "PathInContainer": "/dev/video0",
                      "CgroupPermissions": "rwm"
                    }
                  ],
                  "Binds": [
                    "/var/camera-bridge/snapshots:/data/snapshots"
                  ],
                  "NetworkMode": "host"
                }
              }
            },
            "env": {
              "CAMERA_DEVICE_PATH": { "value": "/dev/video0" },
              "STREAM_ENABLED":     { "value": "false" },
              "STREAM_PROTOCOL":    { "value": "rtsp" },
              "STREAM_PORT":        { "value": "8554" },
              "LOG_LEVEL":          { "value": "INFO" }
            }
          }
        }
      }
    },
    "$edgeHub": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "routes": {
          "cameraToHub": "FROM /messages/modules/camera-bridge/outputs/* INTO $upstream"
        },
        "storeAndForwardConfiguration": {
          "timeToLiveSecs": 7200
        }
      }
    },
    "camera-bridge": {
      "properties.desired": {
        "streamEnabled": false,
        "streamProfile": {
          "width": 1280,
          "height": 720,
          "fps": 15
        }
      }
    }
  }
}
